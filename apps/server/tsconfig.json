{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"types": ["@cloudflare/workers-types"],
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"paths": {
			"@offbeat/protocol": ["../../packages/protocol/src/index.ts"]
		}
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
