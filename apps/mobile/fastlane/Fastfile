default_platform(:ios)

platform :ios do
  private_lane :app_store_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("APP_STORE_CONNECT_KEY_PATH")),
      duration: 1200,
      in_house: false
    )
  end

  desc "Upload an existing signed IPA to TestFlight"
  lane :upload_testflight do |options|
    ipa_path = File.expand_path(options[:ipa] || ENV.fetch("IOS_IPA_PATH"))
    UI.user_error!("IPA not found: #{ipa_path}") unless File.exist?(ipa_path)

    upload_to_testflight(
      api_key: app_store_api_key,
      ipa: ipa_path,
      app_identifier: "dev.arlyon.offbeat",
      beta_app_description: File.read(
        File.expand_path("metadata/ios/en-US/description.txt", __dir__)
      ).strip,
      changelog: File.read(
        File.expand_path("testflight/what_to_test.txt", __dir__)
      ).strip,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Upload App Store metadata and screenshots without submitting"
  lane :upload_store_metadata do |options|
    deliver_options = {
      api_key: app_store_api_key,
      app_identifier: "dev.arlyon.offbeat",
      metadata_path: File.expand_path("metadata/ios", __dir__),
      screenshots_path: File.expand_path("screenshots", __dir__),
      primary_category: "Music",
      secondary_category: "Social Networking",
      copyright: "2026 Offbeat",
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    }
    deliver_options[:app_version] = options[:version] if options[:version]
    deliver(**deliver_options)
  end
end
