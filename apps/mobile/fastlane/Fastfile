default_platform(:ios)

platform :ios do
  desc "Upload an existing signed IPA to TestFlight"
  lane :upload_testflight do |options|
    ipa_path = File.expand_path(options[:ipa] || ENV.fetch("IOS_IPA_PATH"))
    UI.user_error!("IPA not found: #{ipa_path}") unless File.exist?(ipa_path)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("APP_STORE_CONNECT_KEY_PATH")),
      duration: 1200,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      app_identifier: "dev.arlyon.offbeat",
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
